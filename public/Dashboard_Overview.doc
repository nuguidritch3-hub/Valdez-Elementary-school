  <style>
    body { font-family: 'Calibri', 'Arial', sans-serif; line-height: 1.6; font-size: 11pt; color: #1e293b; padding: 20px; }
    h1 { color: #1e3a8a; font-size: 20pt; border-bottom: 2px solid #3b82f6; padding-bottom: 5px; margin-top: 30px; margin-bottom: 12px; font-weight: bold; }
    h2 { color: #2563eb; font-size: 16pt; margin-top: 25px; margin-bottom: 10px; font-weight: bold; }
    h3 { color: #0f766e; font-size: 13pt; margin-top: 20px; margin-bottom: 8px; font-weight: bold; }
