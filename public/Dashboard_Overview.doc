    table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 15px; font-size: 10.5pt; }
    th { background-color: #e2e8f0; font-weight: bold; border: 1px solid #94a3b8; padding: 10px; text-align: left; color: #1e293b; }
